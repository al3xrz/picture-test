# Admin credentials (HTTP Basic) — change before deploying!
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Upload limit per image (MB)
MAX_UPLOAD_MB=5

# Host port for the web UI
WEB_PORT=8080

# Comma-separated allowed origins (only needed if frontend runs on another origin)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
